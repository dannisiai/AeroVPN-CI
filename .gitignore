# Upstream build artifacts: built from SagerNet/sing-box via
# scripts/make_libbox_aar.py / make_apple_framework.py / fetch_upstream_cores.*.
# These stay ignored so the placeholder stubs that once lived here can never be
# committed by accident. The REAL cores are published by the
# "Build Upstream Core Artifacts" workflow, which commits them with `git add -f`
# (single-writer), pinned to the version in core/upstream.env.
client/android/app/libs/libbox.aar
client/android/app/libs/classes.jar
client/ios/Frameworks/Libbox.xcframework/
client/macos/Runner/sing-box

# Control-plane runtime state (users/sessions/verification codes) - never commit
backend-spec/db.json

# Upstream clones
core/upstream/

