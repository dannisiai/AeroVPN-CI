# AeroVPN Control Plane — environment template
# Copy to .env (server) or export in production. Never commit real secrets.
PORT=8088

# Bind address. Keep 127.0.0.1 and let the reverse proxy terminate TLS in front
# (see deploy/CONTROL_PLANE.md). Set to 0.0.0.0 only for local device testing.
BIND_ADDR=127.0.0.1

# Set to 1 when a reverse proxy terminates TLS: rate limiting then keys on the
# X-Forwarded-For / X-Real-IP client address instead of the proxy's own address.
TRUST_PROXY=0

# Production mode. With PRODUCTION=1 the server refuses to start unless real node
# credentials are present (no silent empty-credential tunnels).
NODE_ENV=production
PRODUCTION=1

# Dedicated HMAC pepper for verification-code digests. REQUIRED in production.
# It MUST be an independent strong random value - never reuse the Resend key or
# any other credential as this secret. Generate with:  openssl rand -hex 32
# Rotating it invalidates outstanding verification codes (15-minute TTL) only.
OTP_HMAC_SECRET=

RESEND_API_KEY=
RESEND_DOMAIN_ID=
RESEND_FROM=AeroVPN <noreply@your-domain.example>

# Upstream node credentials (injected per-request at POST /v1/connect).
# Production MUST set all of these; empty values refuse to serve real tunnels.
# There is deliberately no committed default: a real node IP is infrastructure
# data and never belongs in the repository. 203.0.113.x below are placeholders.
NODE_SERVER_IP=203.0.113.10
NODE_HY2_PORT=9443
NODE_HY2_PASSWORD=
NODE_HY2_OBFS_PASSWORD=
NODE_HY2_SNI=your-node-sni.example
# Optional server-declared capacity (Mbps). Leave unset (or 0) to keep the
# sing-box default (BBR congestion control); set real values only when they
# reflect the node's actual provisioned bandwidth.
NODE_HY2_UP_MBPS=0
NODE_HY2_DOWN_MBPS=0
NODE_VLESS_PORT=443
NODE_VLESS_UUID=
NODE_VLESS_SNI=
NODE_VLESS_REALITY_PUB=
NODE_VLESS_REALITY_SHORT=

# --- Per-region nodes (optional) -------------------------------------------
# When a region has its own host below, it is advertised separately and its
# credentials are used instead of the shared NODE_* set. Regions without
# <PREFIX>_SERVER_IP fall back to the shared node, so a single-node deployment
# keeps working with just the NODE_* variables above.
# Repeat the block per region: NODE_US, NODE_JP, NODE_SG.
#NODE_US_SERVER_IP=
#NODE_US_HY2_PORT=9443
#NODE_US_HY2_PASSWORD=
#NODE_US_HY2_OBFS_PASSWORD=
#NODE_US_HY2_SNI=
#NODE_US_HY2_UP_MBPS=0
#NODE_US_HY2_DOWN_MBPS=0
#NODE_US_VLESS_PORT=443
#NODE_US_VLESS_UUID=
#NODE_US_VLESS_SNI=
#NODE_US_VLESS_REALITY_PUB=
#NODE_US_VLESS_REALITY_SHORT=

