# ==============================================================================
# AeroVPN - Single source of truth for the pinned upstream (SagerNet) core build.
#
# Consumed by: core/scripts/build_android_aar.sh, core/scripts/build_apple_xcframework.sh,
#              scripts/fetch_upstream_cores.sh (source), scripts/make_libbox_aar.py,
#              scripts/make_apple_framework.py (parsed), .github/workflows (kept in sync).
# Keep the version/tags in this file only - the mobile cores, the desktop core binaries
# and the generated sing-box config must all target the SAME upstream release.
#
# Build tags and why they are here (verified against upstream sources at UPSTREAM_VERSION):
#   with_quic      - hysteria2 is QUIC based and is the control plane's default protocol
#   with_wireguard - WireGuard endpoint support
#   with_utls      - uTLS fingerprints used by the generated vless/trojan TLS config
#   with_clash_api - experimental.clash_api (loopback telemetry with a per-session secret)
#   with_gvisor    - supports `stack: mixed` plus iOS `gvisor` when includeAllNetworks is enabled
#
# NEVER re-add `with_ech`: upstream removed it (common/tls/ech_tag_stub.go fails the build
# on purpose when the tag is set). ECH itself is provided by the standard library now.
# ==============================================================================

UPSTREAM_REPO="https://github.com/SagerNet/sing-box.git"
UPSTREAM_VERSION="v1.14.3"
UPSTREAM_COMMIT="7054cac5124465ffdb145870d7c01885566711b1"
# with_quic      - hysteria2 is QUIC based and is the control plane's default protocol
# with_wireguard - WireGuard endpoint support
# with_utls      - uTLS fingerprints used by the generated vless/trojan TLS config
# with_clash_api - experimental.clash_api (loopback telemetry with a per-session secret)
# with_gvisor    - supports `stack: mixed` plus iOS `gvisor` when includeAllNetworks is enabled
# badlinkname,tfogo_checklinkname0 - upstream's own tags: libbox reaches into os
#   internals (os.checkPidfdOnce) and the build fails with "invalid reference to
#   os.checkPidfdOnce" unless the linker's linkname check is disabled via the
#   matching -checklinkname=0 ldflag below.
UPSTREAM_BUILD_TAGS="with_quic,with_wireguard,with_utls,with_clash_api,with_gvisor,badlinkname,tfogo_checklinkname0"

# Linker flags: -checklinkname=0 pairs with the badlinkname tag; -s -w strip the binary.
UPSTREAM_LDFLAGS="-s -w -buildid= -checklinkname=0"

# Pure Go macOS desktop CLI: Go 1.27 targets macOS 13+. No host Xcode/CGO linkage.
MACOS_GO_VERSION="1.27.1"

# Upstream builds libbox with its own gomobile fork (Makefile: lib_install target).
GOMOBILE_VERSION="v0.1.13"

# NDK pinned by upstream for libbox builds (cmd/internal/build_shared/sdk.go: fixedVersion).
ANDROID_NDK_VERSION="28.0.13004108"
# libbox `-androidapi`: the AAR manifest minSdkVersion. Kept at 21 so the artifact stays
# installable on any Flutter minSdk (upstream ships 24/21 variants; we only need one).
ANDROID_API_LEVEL="21"
